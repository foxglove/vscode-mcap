{
  "name": "mcap-viewer",
  "displayName": "MCAP Viewer",
  "description": "Inspect MCAP files and visualize with Foxglove",
  "version": "0.1.0",
  "publisher": "foxglove",
  "repository": {
    "type": "git",
    "url": "https://github.com/foxglove/vscode-mcap"
  },
  "homepage": "https://github.com/foxglove/vscode-mcap#readme",
  "bugs": {
    "url": "https://github.com/foxglove/vscode-mcap/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:mcap.viewer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mcap.viewer",
        "displayName": "MCAP Viewer",
        "selector": [
          {
            "filenamePattern": "*.mcap"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mcap.setApiKey",
        "title": "MCAP: Set Foxglove API Key"
      },
      {
        "command": "mcap.clearApiKey",
        "title": "MCAP: Clear Foxglove API Key"
      }
    ],
    "configuration": {
      "title": "MCAP Viewer",
      "properties": {
        "mcap.orgSlug": {
          "type": "string",
          "default": "",
          "description": "Foxglove organization slug for embedded viewer sign-in."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "npm run release:check && vsce package --no-dependencies",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "screenshot": "npm run build && node scripts/integration.mjs --screenshot",
    "format": "prettier --write src webview test scripts package.json tsconfig.json .github *.md",
    "format:check": "prettier --check src webview test scripts package.json tsconfig.json .github *.md",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "release:check": "npm run verify && node scripts/release-check.mjs",
    "package:local": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@foxglove/embed": "0.70.0",
    "@mcap/core": "^2.2.2",
    "@mcap/support": "^1.1.0"
  },
  "devDependencies": {
    "@types/lz4js": "^0.2.2",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "lz4js": "^0.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "mcap",
    "foxglove",
    "robotics",
    "ros",
    "rosbag",
    "visualization"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "author": "Foxglove",
  "license": "MIT"
}
